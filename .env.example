# Copy this file to .env and fill in your institution's mail server.
# .env is ignored by git. Never commit real passwords.

SMTP_HOST=smtp.example.edu
SMTP_PORT=587
# true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=origyn@example.edu
SMTP_PASS=change-me
MAIL_FROM="Origyn <origyn@example.edu>"

# Optional: the address people use to open Origyn, used for the sign-in link.
APP_URL=http://192.168.1.10:8080

# Optional: port of the mail service (the Vite servers forward /api/mail here).
MAIL_PORT=8787
